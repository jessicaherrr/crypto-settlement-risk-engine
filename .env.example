# ============================================
# Crypto Settlement Risk Engine - environment variables
# ============================================

# --- Wallet / RainbowKit ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Polygon RPC ---
NEXT_PUBLIC_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology

# --- Contract deployment (hardhat) ---
PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# --- Risk oracle (public address matching the quant/ risk engine's RiskQuote
#     signing key; defaults to the deployer address until that key exists) ---
RISK_ORACLE_ADDRESS=

# --- Chain the frontend/wallet should use (apps/web/lib/chain/config.ts) ---
# 80002 = Polygon Amoy (default), 31337 = local Hardhat node.
NEXT_PUBLIC_CHAIN_ID=80002
# Override only if you don't want the chain's default public RPC - e.g.
# http://127.0.0.1:8545 for a local Hardhat node.
NEXT_PUBLIC_RPC_URL=

# --- RiskEscrow contract address (populated by contracts/scripts/deploy.js) ---
NEXT_PUBLIC_RISK_ESCROW_ADDRESS=

# --- Settlement-asset allowlist beyond native ETH/POL (apps/web/lib/chain/assets.ts) ---
# A JSON array, e.g. [{"address":"0x...","symbol":"tWETH","decimals":18}].
# Leave unset to offer only the native asset.
NEXT_PUBLIC_SETTLEMENT_ASSETS=

# --- Risk oracle service (apps/web/app/api/quote/request calls this) ---
# Not set here: RISK_ORACLE_PRIVATE_KEY is the quant/ service's own secret
# (the private key matching RISK_ORACLE_ADDRESS above) and must never be
# committed or set anywhere this file's values end up - export it directly
# in the environment running `uvicorn askgene_quant.service.app:app`.
RISK_SERVICE_URL=http://localhost:8001

# --- Chain indexer (services/chain-indexer) ---
# Read-only service: never needs a private key, only an RPC endpoint, the
# RiskEscrow address/chain to watch, and a Postgres connection. See
# services/chain-indexer/README.md for the full variable list and defaults.
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
RISK_ESCROW_ADDRESS=
START_BLOCK=0
CONFIRMATION_DEPTH=12

# apps/web polls this (lib/server/indexer.ts) to show the indexer's
# health badge/panel - the same health endpoint HEALTH_ADDR above serves.
INDEXER_HEALTH_URL=http://localhost:8090/

# --- Database ---
# One Postgres, read by both the chain indexer (above) and the Next.js app
# (apps/web/lib/server/db.ts) - the dashboard only shows real confirmed
# state because both sides point at the same database, not a separate copy.
DATABASE_URL=postgres://askgene:askgene@localhost:5432/askgene_quantfi
